#!/usr/bin/env bash
# Format and lint staged GDScript before commit.
# Requires: ./hack/setup.sh (once per clone)
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GDFORMAT="$REPO_ROOT/.venv/bin/gdformat"
GDLINT="$REPO_ROOT/.venv/bin/gdlint"

if [[ ! -x "$GDFORMAT" ]] || [[ ! -x "$GDLINT" ]]; then
	cat >&2 <<'EOF'
pre-commit: GDScript toolkit not found in .venv/

Run once per clone:
  ./hack/setup.sh
EOF
	exit 1
fi

cd "$REPO_ROOT"

STAGED_GD=()
while IFS= read -r file; do
	[[ -n "$file" ]] && STAGED_GD+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM | { grep -E '\.gd$' || true; })

if [[ ${#STAGED_GD[@]} -eq 0 ]]; then
	exit 0
fi

EXISTING=()
for file in "${STAGED_GD[@]}"; do
	if [[ -f "$file" ]]; then
		EXISTING+=("$file")
	fi
done

if [[ ${#EXISTING[@]} -eq 0 ]]; then
	exit 0
fi

"$GDFORMAT" "${EXISTING[@]}"
git add -- "${EXISTING[@]}"
"$GDLINT" "${EXISTING[@]}"
