#!/usr/bin/env bash
# Validates Conventional Commits for changelog-friendly history.
# Install: ./hack/setup.sh

set -euo pipefail

COMMIT_MSG_FILE="${1:?commit-msg hook requires path to message file}"
MSG="$(head -n1 "$COMMIT_MSG_FILE")"

# Merge, revert, and autosquash commits are exempt.
if [[ "$MSG" =~ ^Merge\  ]] \
	|| [[ "$MSG" =~ ^Revert\  ]] \
	|| [[ "$MSG" =~ ^(fixup|squash)! ]]; then
	exit 0
fi

COMMIT_PATTERN='^(feat|fix|docs|refactor|chore)(\((addons|assets|core|actors|world|ui|cursor|hack|libs|plans|tests)\))?: [a-z].+'

if [[ ! "$MSG" =~ $COMMIT_PATTERN ]]; then
	cat >&2 <<'EOF'
commit-msg: invalid commit message

Expected: type: description  or  type(scope): description
  Types:  feat, fix, docs, refactor, chore
  Scopes: addons, assets, core, actors, world, ui, cursor, hack, libs, plans, tests (optional)

Examples:
  chore: update cursor rules
  feat(actors): add sprint movement

Description must start with a lowercase letter (imperative mood).
EOF
	exit 1
fi
